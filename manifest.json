{
  "manifest_version": 3,
  "name": "Clarity for Instagram: Hide Distractions",
  "version": "1.0",
  "description": "Removes Instagram stories from the UI",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
